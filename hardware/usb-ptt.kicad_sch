	(text "PROVISIONAL CAD-A01 / CAD-A02 — NOT FOR FABRICATION"
		(at 25.4 17.78 0) (effects (font (size 2.54 2.54) (bold yes)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000001"))
	(text "COMPUTER DOMAIN (USB_5V, COMPUTER_GND)                                                    FLOATING RADIO CLOSURE"
		(at 25.4 25.4 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000002"))
	(text "J100 USB-C receptacle candidate GCT USB4105-xx-A: VBUS=USB_5V; CC1/CC2 each R100/R101 5.1k to COMPUTER_GND."
		(at 25.4 35.56 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000003"))
	(text "D100 TPD2EUSB30DRTR: USB_D+ / USB_D− ESD clamp to COMPUTER_GND; R102/R103 22R series at U100."
		(at 25.4 43.18 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000004"))
	(text "U100 CP2102N-A02-GQFN24-R: VREGIN=USB_5V; VDD=3V3; C100 1u + C101 100n; VBUS sense from USB_5V."
		(at 25.4 50.8 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000005"))
	(text "Default-off: /RTS pulled high R104 10k → U101 SN74LVC1G04 inverter → REQUEST; SUSPENDb pulled low R105 10k = USB_READY."
		(at 25.4 58.42 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000006"))
	(text "U102 SN74LVC1G08 AND qualifies REQUEST with USB_READY. Reset, unpowered and suspend leave DRIVE low (CAD-A02)."
		(at 25.4 66.04 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000007"))
	(text "U103 LTC6993-1 non-retriggerable limiter: DIVCODE=7, RSET=480k 1%, R106=1M/R107=887k 1%; 20.13 s nominal."
		(at 25.4 73.66 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000008"))
	(text "Early release gates output immediately but does not reset U103; held request cannot retrigger after expiry. Timing/margins unmeasured."
		(at 25.4 81.28 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000009"))
	(text "Q100 MMBT3904,215: R108 1k base, R109 100k B-E; R110 470R USB_5V → K100 AQY212GS LED → collector."
		(at 25.4 88.9 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000010"))
	(text "K100 Panasonic AQY212GS PhotoMOS candidate: output terminals connect ONLY PTT ↔ PTT_RETURN. No COMPUTER_GND connection."
		(at 25.4 96.52 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000011"))
	(text "D101 + R111 separate computer-side PTT LED. TP100 USB_5V, TP101 COMPUTER_GND, TP102 REQUEST, TP103 DRIVE, TP104 PTT, TP105 PTT_RETURN."
		(at 25.4 104.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000012"))
	(text "Physical-finalization inputs: connector/ESD lands, host reset/suspend, radio PTT V/I/leakage, closure margin and timer bench evidence."
		(at 25.4 111.76 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000013"))
	(text "HOST / COMPUTER DOMAIN: USB_5V, COMPUTER_GND — USB-C, bridge, timer, driver and indicator return here"
		(at 27.94 132.08 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000018"))
	(text "FLOATING RADIO-SIDE PHOTO-MOS OUTPUT: PTT, PTT_RETURN — intentionally no wire or ground across isolation"
		(at 27.94 142.24 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)) (uuid "10000000-0000-4000-8000-000000000023"))
	(text_box "Functional connectivity: USB-C D+/D− → D100 → R102/R103 → U100. U100 /RTS → U101 → REQUEST; U100 SUSPENDb → USB_READY; U102/U103 gate DRIVE → Q100 → K100 input. K100 output is the isolated PTT/PTT_RETURN closure.\n\nCAD-A02: identities, pin maps, footprints and values are documentary provisional defaults. Physical-finalization measurements may revise the circuit before freeze."
